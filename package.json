{
  "name": "setup-sst",
  "description": "GitHub Action to install and cache SST providers, cutting minutes off every CI run",
  "version": "1.0.0",
  "author": "Bruno Leite",
  "private": true,
  "homepage": "https://github.com/brunocleite/setup-sst",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/brunocleite/setup-sst.git"
  },
  "bugs": {
    "url": "https://github.com/brunocleite/setup-sst/issues"
  },
  "keywords": [
    "actions",
    "github-actions",
    "node",
    "setup",
    "sst",
    "sst-v3",
    "ion",
    "iac",
    "pulumi",
    "cache",
    "aws",
    "serverless"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "all": "npm run format:write && npm run lint && npm run test && npm run coverage && npm run package",
    "bundle": "npm run format:write && npm run package",
    "ci-test": "npx jest",
    "coverage": "npx make-coverage-badge --output-path ./badges/coverage.svg",
    "format:check": "npx prettier --check .",
    "format:write": "npx prettier --write .",
    "lint": "npx eslint .",
    "package": "npm run package:main && npm run package:post",
    "package:main": "npx ncc build src/main.ts -o dist/main --source-map --license licenses.txt",
    "package:post": "npx ncc build src/post.ts -o dist/post --source-map --license licenses.txt",
    "package:watch": "npm run package:main -- --watch",
    "super-lint": "docker run -e LOG_LEVEL=DEBUG -e RUN_LOCAL=true --env-file \".github/linters/super-linter.env\" -v \"$(pwd)\":/tmp/lint --rm ghcr.io/super-linter/super-linter:v8",
    "test": "npx jest",
    "test:fixtures": "npm --prefix __test_environments__/with-npm ci"
  },
  "license": "MIT",
  "jest": {
    "preset": "ts-jest",
    "verbose": true,
    "clearMocks": true,
    "testEnvironment": "node",
    "moduleFileExtensions": [
      "js",
      "ts"
    ],
    "testMatch": [
      "**/*.test.ts"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/dist/"
    ],
    "transform": {
      "^.+\\.ts$": [
        "ts-jest",
        {
          "tsconfig": "tsconfig.test.json"
        }
      ]
    },
    "coverageReporters": [
      "json-summary",
      "text",
      "lcov"
    ],
    "collectCoverage": true,
    "collectCoverageFrom": [
      "./src/**"
    ],
    "coverageThreshold": {
      "global": {
        "statements": 90,
        "branches": 80,
        "functions": 90,
        "lines": 90
      }
    }
  },
  "dependencies": {
    "@actions/cache": "^6.2.0",
    "@actions/core": "^2.0.3",
    "@actions/exec": "^2.0.0",
    "@actions/glob": "^0.5.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@jest/globals": "^30.5.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.20.2",
    "@typescript-eslint/eslint-plugin": "^8.70.0",
    "@typescript-eslint/parser": "^8.70.0",
    "@vercel/ncc": "^0.38.4",
    "eslint": "^9.39.5",
    "eslint-plugin-jest": "^29.16.6",
    "eslint-plugin-jsonc": "^2.21.1",
    "eslint-plugin-prettier": "^5.5.6",
    "jest": "^30.5.1",
    "make-coverage-badge": "^1.2.0",
    "prettier": "^3.9.6",
    "ts-jest": "^29.4.12",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.0"
  },
  "overrides": {
    "minimatch": "^10.2.6",
    "brace-expansion": "^5.0.9",
    "picomatch": "^4.0.7"
  }
}
